# =============================================
# PATRIMOVE - Variáveis de Ambiente (exemplo)
# =============================================

# --- Banco de Dados ---
POSTGRES_USER="simap"
POSTGRES_PASSWORD="simap_forte"
POSTGRES_DB="simap"
DATABASE_URL="postgresql://simap:simap_forte@localhost:5432/simap?schema=public"

# --- Aplicação ---
APP_PORT="3000"
APP_URL="http://localhost:3000"
TOKEN_EXPIRY_DAYS="7"
APP_DOMAIN="simap.intra.jfap"
# Nível do pino logger: trace|debug|info|warn|error|fatal. Default: info em prod, debug em dev.
# LOG_LEVEL="info"
# Origens permitidas em modo dev quando o servidor escuta em IP da LAN (HMR no celular).
# Lista separada por vírgula. Vazio em produção.
# ALLOWED_DEV_ORIGINS="192.168.100.228"

# --- NextAuth ---
NEXTAUTH_SECRET="gerar-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Em produção atrás de proxy TLS, defina ambos:
#   NEXTAUTH_URL_INTERNAL="http://app:3000"   # URL interna (rede docker) para chamadas server->server
#   AUTH_TRUST_HOST="true"                    # confia no Host vindo do proxy

# --- LDAP / Active Directory ---
# LDAP_URL="ldap://ldap.jfap.jus.br:389"
# LDAP_BIND_DN="cn=admin,dc=jfap,dc=jus,dc=br"
# LDAP_BIND_PASSWORD=""
# LDAP_SEARCH_BASE="dc=jfap,dc=jus,dc=br"
# LDAP_SEARCH_FILTER="(sAMAccountName={{username}})"
# LDAP_USERNAME_CASE="upper"
# LDAP_TIMEOUT_MS="10000"
# LDAP_CONNECT_TIMEOUT_MS="8000"
# LDAP_TLS_REJECT_UNAUTHORIZED="true"
# LDAP_DEFAULT_PROVISION_PERFIL="SERVIDOR_RESPONSAVEL"

# --- SICAM Oracle (leitura do banco legado) ---
# SICAM_ORACLE_USER="simap_ro"
# SICAM_ORACLE_PASSWORD=""
# Formato Easy Connect: host:porta/servicename (ex: oradb.jfap.intra:1521/SICAM)
# SICAM_ORACLE_CONNECT_STRING="oradb.jfap.intra:1521/SICAM"
# SICAM_ORACLE_POOL_MIN="1"
# SICAM_ORACLE_POOL_MAX="4"
# SICAM_ORACLE_POOL_INCREMENT="1"
# SICAM_ORACLE_POOL_TIMEOUT="60"
# SICAM_ORACLE_QUERY_TIMEOUT_MS="5000"
# Schema dono das tabelas do SICAM (filtra ALL_TABLES/ALL_TAB_COLUMNS). Opcional.
# SICAM_ORACLE_SCHEMA_OWNER="SICAM"
# Caminho do Oracle Instant Client (Basic Light, x64). Quando definido, ativa Thick mode.
# Necessário se o servidor SICAM usa password verifier legado 10G (erro NJS-116 em Thin mode).
# Windows: "C:\\oracle\\instantclient_23_4"
# Linux:   "/opt/oracle/instantclient_23_4"
# SICAM_ORACLE_INSTANT_CLIENT_DIR=""
# Diretório com sqlnet.ora dedicado ao SIMAP — isola do TNS_ADMIN global do sistema.
# Recomendado apontar para deploy/oracle-config/ neste repo (já inclui sqlnet.ora com EZCONNECT).
# SICAM_ORACLE_CONFIG_DIR=""

# --- SMTP (E-mail) ---
SMTP_HOST="smtp.jfap.jus.br"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="simap@jfap.jus.br"

# --- Backup do banco (somente producao) ---
# Retencao em dias para os dumps em deploy/backups/.
BACKUP_RETENTION_DAYS="14"
# Intervalo entre dumps em segundos (86400 = 24h).
BACKUP_INTERVAL_SECONDS="86400"
